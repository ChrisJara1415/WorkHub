<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - WorkHub Admin</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <style>
        .sidebar {
            min-height: 100vh;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
        .sidebar .nav-link {
            color: rgba(255, 255, 255, 0.8);
            border-radius: 8px;
            margin: 2px 0;
            transition: all 0.3s ease;
        }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            color: white;
            background-color: rgba(255, 255, 255, 0.1);
            /* Evitar desplazamiento en hover */
            transform: none;
        }
        .main-content {
            background-color: #f8f9fa;
            min-height: 100vh;
        }
        .card {
            border: none;
            border-radius: 15px;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
            /* Evitar movimientos en hover */
            transition: none;
        }
        .card:hover { transform: none; }
        .stat-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }
        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none;
            border-radius: 25px;
            padding: 10px 25px;
        }
        .table {
            border-radius: 15px;
            overflow: hidden;
        }
        .table th, .table td { vertical-align: middle; text-align: center; }
        .table .table-actions { display: flex; justify-content: center; gap: .5rem; }
        .table .btn-action { border-radius: .5rem; }
        .toast-container { position: fixed; bottom: 1rem; right: 1rem; z-index: 1080; }
        #confirmDeleteModal .modal-dialog { display: flex; align-items: center; min-height: calc(100% - 1rem); }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <nav class="col-md-3 col-lg-2 d-md-block sidebar collapse">
                <div class="position-sticky pt-3">
                    <div class="text-center mb-4">
                        <h4 class="text-white">
                            <i class="bi bi-gear-fill"></i>
                            WorkHub Admin
                        </h4>
                    </div>
                    
                    <ul class="nav flex-column">
                        <li class="nav-item">
                            <a class="nav-link <%= activeMenu === 'dashboard' ? 'active' : '' %>" href="/admin">
                                <i class="bi bi-speedometer2"></i>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activeMenu === 'users' ? 'active' : '' %>" href="/admin/usuarios">
                                <i class="bi bi-people"></i>
                                Usuarios
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activeMenu === 'offers' ? 'active' : '' %>" href="/admin/ofertas">
                                <i class="bi bi-briefcase"></i>
                                Ofertas
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activeMenu === 'contracts' ? 'active' : '' %>" href="/admin/contratos">
                                <i class="bi bi-file-earmark-text"></i>
                                Contratos
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activeMenu === 'applyments' ? 'active' : '' %>" href="/admin/postulaciones">
                                <i class="bi bi-person-check"></i>
                                Postulaciones
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link <%= activeMenu === 'reports' ? 'active' : '' %>" href="/admin/reportes">
                                <i class="bi bi-flag"></i>
                                Reportes
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

            <!-- Main content -->
                        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 main-content">
                <div class="pt-3 pb-2 mb-3">
                    <%- body %>
                </div>
            </main>
        </div>
    </div>

        <!-- Toasts container -->
        <div class="toast-container" aria-live="polite" aria-atomic="true"></div>

        <!-- Modal confirmación eliminación -->
        <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Confirmar eliminación</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p id="confirmDeleteText">¿Estás seguro de querer eliminar este elemento?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <form id="confirmDeleteForm" method="POST">
                            <input type="hidden" name="_method" value="DELETE" />
                            <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal genérico de detalles -->
        <div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="detailsModalTitle">Detalle</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div id="detailsModalBody"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Custom Scripts -->
    <script>
                // Mostrar Toast Bootstrap (éxito o error)
                function showToast(message, type = 'success') {
                        const container = document.querySelector('.toast-container');
                        const bg = type === 'success' ? 'text-bg-success' : 'text-bg-danger';
                        const icon = type === 'success' ? 'bi-check-circle' : 'bi-exclamation-triangle';
                        const el = document.createElement('div');
                        el.className = `toast align-items-center ${bg}`;
                        el.setAttribute('role', 'alert');
                        el.setAttribute('aria-live', 'assertive');
                        el.setAttribute('aria-atomic', 'true');
                        el.innerHTML = `
                            <div class="d-flex">
                                <div class="toast-body d-flex align-items-center gap-2">
                                    <i class="bi ${icon}"></i>
                                    <span>${message}</span>
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>`;
                        container.appendChild(el);
                        const t = new bootstrap.Toast(el, { delay: 3500 });
                        t.show();
                        el.addEventListener('hidden.bs.toast', () => el.remove());
                }

                // Leer mensajes desde querystring y mostrarlos como toasts
                (function() {
                        const p = new URLSearchParams(window.location.search);
                        if (p.get('success')) showToast(p.get('success'), 'success');
                        if (p.get('error')) showToast(p.get('error'), 'danger');
                })();

                // Modal de confirmación de eliminación
                document.addEventListener('DOMContentLoaded', () => {
                        const modalEl = document.getElementById('confirmDeleteModal');
                        const modal = new bootstrap.Modal(modalEl);
                        const text = document.getElementById('confirmDeleteText');
                        const form = document.getElementById('confirmDeleteForm');

            document.body.addEventListener('click', (e) => {
                                const btn = e.target.closest('.btn-delete');
                                if (!btn) return;
                                e.preventDefault();
                const action = btn.getAttribute('data-action') || btn.getAttribute('href');
                if (!action || action === '#' || action.endsWith('/null') || action.endsWith('/undefined')) {
                    console.warn('Acción de eliminación inválida:', action);
                    showToast('Acción de eliminación inválida', 'danger');
                    return;
                }
                                const entity = btn.getAttribute('data-entity') || 'elemento';
                                text.textContent = `¿Estás seguro de querer eliminar este ${entity}?`;
                                form.setAttribute('action', action);
                                modal.show();
                        });
                });

                // Modal de detalles (ver más)
                document.addEventListener('DOMContentLoaded', () => {
                    const detailsEl = document.getElementById('detailsModal');
                    const detailsModal = new bootstrap.Modal(detailsEl);
                    const titleEl = document.getElementById('detailsModalTitle');
                    const bodyEl = document.getElementById('detailsModalBody');

                    document.body.addEventListener('click', (e) => {
                        const btn = e.target.closest('.btn-view');
                        if (!btn) return;
                        e.preventDefault();
                        const type = btn.getAttribute('data-entity') || 'Detalle';
                        const encoded = btn.getAttribute('data-record');
                        if (!encoded) return;
                        try {
                            const obj = JSON.parse(decodeURIComponent(encoded));
                            titleEl.textContent = `Detalle de ${type}`;
                            // Construir un resumen bonito
                            const rows = Object.entries(obj).map(([k,v]) => {
                                const val = (v === null || typeof v === 'undefined') ? '—' : v;
                                return `<tr><th class="text-nowrap text-muted">${k}</th><td>${val}</td></tr>`;
                            }).join('');
                            bodyEl.innerHTML = `<div class="table-responsive"><table class="table table-borderless align-middle">${rows}</table></div>`;
                            detailsModal.show();
                        } catch (err) {
                            console.error('No se pudo parsear data-record', err);
                            showToast('No se pudo abrir el detalle', 'danger');
                        }
                    });
                });
    </script>
</body>
</html>