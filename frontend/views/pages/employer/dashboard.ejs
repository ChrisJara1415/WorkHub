<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head') %>

    <body class="bk-angelblank">
        <%- include('../../partials/navbar') %>
            <main class="container py-5">
                <header class="d-flex justify-content-between align-items-center mb-4">
                    <h1 class="h3 m-0">Panel de Empleador</h1>
                </header>

                <section class="mb-4">
                    <button class="btn btn-primary" id="newOfferBtn"><i class="bi bi-plus-circle"></i> Nueva
                        oferta</button>
                </section>

                <section>
                    <h2 class="h5">Mis Ofertas</h2>
                    <div id="myOffers" class="row g-3"></div>
                </section>

                <!-- Modal crear/editar oferta -->
                <div class="modal fade" id="offerModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="offerModalLabel">Crear oferta</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <form id="offerForm">
                                    <input type="hidden" name="_id" />
                                    <div class="mb-3">
                                        <label class="form-label">Título</label>
                                        <input class="form-control" name="nombre" required />
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label">Descripción</label>
                                        <textarea class="form-control" name="descripcion" rows="4" required></textarea>
                                    </div>
                                    <button class="btn btn-primary" type="submit">Guardar</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>
            </main>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
                crossorigin="anonymous"></script>
            <script>
                const toast = (msg, type = 'success') => {
                    const container = document.getElementById('toastContainer');
                    const bg = type === 'success' ? 'text-bg-success' : 'text-bg-danger'
                    const el = document.createElement('div');
                    el.className = `toast align-items-center ${bg}`;
                    el.setAttribute('role', 'alert'); el.setAttribute('aria-live', 'assertive'); el.setAttribute('aria-atomic', 'true');
                    el.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type=\"button\" class=\"btn-close btn-close-white me-2 m-auto\" data-bs-dismiss=\"toast\" aria-label=\"Close\"></button></div>`;
                    container.appendChild(el); new bootstrap.Toast(el, { delay: 3000 }).show(); el.addEventListener('hidden.bs.toast', () => el.remove());
                }

                async function api(path, options = {}) {
                    const res = await fetch(`/api${path}`, { headers: { 'Content-Type': 'application/json' }, credentials: 'include', ...options })
                    if (!res.ok) throw new Error((await res.json()).message || 'Error de red')
                    return res.json()
                }

                async function loadMyOffers() {
                    try {
                        const data = await api('/ofertas');
                        const list = Array.isArray(data?.data) ? data.data : (data?.offers || []);
                        const grid = document.getElementById('myOffers');
                        grid.innerHTML = list.map(o => `
            <div class=\"col-12 col-md-6 col-lg-4\">
              <div class=\"card h-100 shadow-sm\">
                <div class=\"card-body d-flex flex-column\">
                  <h5 class=\"card-title\">${o.nombre || o.titulo || 'Oferta'}</h5>
                  <p class=\"card-text flex-grow-1\">${o.descripcion || o.detalle || 'Sin descripción'}</p>
                  <div class=\"mt-auto d-flex gap-2\">
                    <button class=\"btn btn-outline-primary btn-sm edit-offer\" data-offer='${encodeURIComponent(JSON.stringify(o))}'>Editar</button>
                    <button class=\"btn btn-outline-danger btn-sm delete-offer\" data-id='${o._id}'>Eliminar</button>
                  </div>
                </div>
              </div>
            </div>`).join('');
                    } catch (e) {
                        toast('No se pudieron cargar tus ofertas', 'danger')
                    }
                }

                document.getElementById('newOfferBtn').addEventListener('click', () => {
                    const form = document.getElementById('offerForm');
                    form.reset();
                    form._id.value = '';
                    document.getElementById('offerModalLabel').textContent = 'Crear oferta';
                    const modal = new bootstrap.Modal(document.getElementById('offerModal'));
                    modal.show();
                });

                document.getElementById('offerForm').addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const form = e.target;
                    const payload = Object.fromEntries(new FormData(form).entries());
                    try {
                        if (payload._id) {
                            await api(`/ofertas/${payload._id}`, { method: 'PUT', body: JSON.stringify(payload) })
                            toast('Oferta actualizada');
                        } else {
                            await api('/ofertas', { method: 'POST', body: JSON.stringify(payload) })
                            toast('Oferta creada');
                        }
                        bootstrap.Modal.getInstance(document.getElementById('offerModal')).hide();
                        loadMyOffers();
                    } catch {
                        toast('No se pudo guardar la oferta', 'danger')
                    }
                });

                document.addEventListener('click', async (e) => {
                    const edit = e.target.closest('.edit-offer');
                    const del = e.target.closest('.delete-offer');
                    if (edit) {
                        const offer = JSON.parse(decodeURIComponent(edit.getAttribute('data-offer')));
                        const form = document.getElementById('offerForm');
                        form._id.value = offer._id || '';
                        form.nombre.value = offer.nombre || offer.titulo || '';
                        form.descripcion.value = offer.descripcion || offer.detalle || '';
                        document.getElementById('offerModalLabel').textContent = 'Editar oferta';
                        new bootstrap.Modal(document.getElementById('offerModal')).show();
                    }
                    if (del) {
                        const id = del.getAttribute('data-id');
                        if (!confirm('¿Eliminar esta oferta?')) return;
                        try {
                            await api(`/ofertas/${id}`, { method: 'DELETE' })
                            toast('Oferta eliminada')
                            loadMyOffers()
                        } catch { toast('No se pudo eliminar', 'danger') }
                    }
                });

                loadMyOffers();
            </script>
    </body>

</html>