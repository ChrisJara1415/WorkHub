<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Ofertas</h2>
        <!-- Botón para crear oferta -->
        <a href="/admin/ofertas/crear" class="btn btn-primary">
          <i class="bi bi-plus-lg"></i> Nueva Oferta
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <!-- Buscador y filtros -->
          <form method="GET" class="row g-3 mb-3">
            <div class="col-md-6">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="q" placeholder="Buscar por servicio o empleador" value="<%= (typeof q !== 'undefined' && q) ? q : '' %>">
              </div>
            </div>
            <div class="col-md-3">
              <select class="form-select" name="categoria">
                <option value="">Todas las categorías</option>
                <% ['Jardinería','Limpieza','Piscinero','Carpintería','Mantenimiento','Plomería'].forEach(cat => { %>
                  <option value="<%= cat %>" <%= (categoria===cat) ? 'selected' : '' %>><%= cat %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2">
              <select class="form-select" name="visible">
                <option value="">Visibilidad</option>
                <option value="true" <%= (visible==='true') ? 'selected' : '' %>>Visible</option>
                <option value="false" <%= (visible==='false') ? 'selected' : '' %>>Oculta</option>
              </select>
            </div>
            <div class="col-md-1 d-grid">
              <button type="submit" class="btn btn-outline-primary"><i class="bi bi-filter"></i></button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
              <thead>
                <tr>
                  <th>Servicio</th>
                  <th>Empleador</th>
                  <th>Municipio</th>
                  <th>Categoría</th>
                  <th>Precio</th>
                  <th>Visible</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if ((offers || []).length > 0) { %>
                  <% offers.forEach(of => { %>
                    <tr>
                      <td><%= of.nombreServicio %></td>
                      <td><%= of.empleador && of.empleador.nombre ? of.empleador.nombre : 'N/A' %></td>
                      <td><%= of.municipio && of.municipio.nombre ? of.municipio.nombre : 'N/A' %></td>
                      <td><%= of.categoria %></td>
                      <td>$<%= new Intl.NumberFormat('es-CO').format(of.precioReferencia || 0) %></td>
                      <td>
                        <% if (of.visible) { %>
                          <span class="badge text-bg-success">Sí</span>
                        <% } else { %>
                          <span class="badge text-bg-secondary">No</span>
                        <% } %>
                      </td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary btn-view" data-entity="oferta" data-record="<%= encodeURIComponent(JSON.stringify({
                          id: of._id,
                          servicio: of.nombreServicio,
                          empleador: of.empleador && of.empleador.nombre,
                          municipio: of.municipio && of.municipio.nombre,
                          categoria: of.categoria,
                          precio: of.precioReferencia,
                          visible: of.visible ? 'Sí' : 'No'
                        })) %>">
                          <i class="bi bi-eye"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-primary" href="/admin/ofertas/<%= of._id %>/editar">
                          <i class="bi bi-pencil-square"></i>
                        </a>
                        <a class="btn btn-sm btn-outline-danger btn-delete" data-entity="oferta" data-action="/admin/ofertas/<%= of._id %>">
                          <i class="bi bi-trash"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No hay ofertas registradas</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
          <!-- Paginación renderizada en servidor usando variables pasadas desde la ruta -->
          <% if (pagination && pagination.totalPages > 1) { %>
            <nav aria-label="Paginación de ofertas">
              <ul class="pagination justify-content-center">
                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                  <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>&limit=<%= pagination.limit || 10 %><%= q ? '&q=' + encodeURIComponent(q) : '' %><%= categoria ? '&categoria=' + encodeURIComponent(categoria) : '' %><%= typeof visible !== 'undefined' && visible !== '' ? '&visible=' + encodeURIComponent(visible) : '' %>"><%= p %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
