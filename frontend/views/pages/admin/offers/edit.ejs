

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
  <h2>Editar Oferta</h2>
  <!-- Ruta en español -->
  <a href="/admin/ofertas" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Volver
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <!-- Formulario SSR: envía al servidor usando method-override -->
          <form id="editOfferForm" method="POST" action="/admin/ofertas/<%= (offer && (offer._id || offer.id)) %>?_method=PUT">
            <input type="hidden" id="offerId" name="id" value="<%= (offer && (offer._id || offer.id)) %>">
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="nombreServicio" class="form-label">Servicio *</label>
                  <!-- nombreServicio según el modelo -->
                  <input type="text" class="form-control" id="nombreServicio" name="nombreServicio" value="<%= offer?.nombreServicio || '' %>" required>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleador_id" class="form-label">Empleador *</label>
                  <!-- Notación de objeto para req.body.empleador.idUsuario; lista de empleadores -->
                  <select class="form-select" id="empleador_id" name="empleador[idUsuario]" required>
                    <% (employers || []).forEach(emp => { %>
                      <option value="<%= emp._id || emp.id %>" <%= (offer?.empleador?.idUsuario?.toString() === (emp._id || emp.id)?.toString()) ? 'selected' : '' %>>
                        <%= emp.nombres %> <%= emp.apellidos %>
                      </option>
                    <% }) %>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="municipio" class="form-label">Municipio *</label>
                  <!-- Notación de objeto para req.body.municipio.nombre -->
                  <input type="text" class="form-control" id="municipio" name="municipio[nombre]" value="<%= offer?.municipio?.nombre || '' %>" required>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="categoria" class="form-label">Categoría *</label>
                  <select class="form-select" id="categoria" name="categoria" required>
                    <option value="">Seleccionar categoría...</option>
                    <option value="Jardinería" <%= offer?.categoria === 'Jardinería' ? 'selected' : '' %>>Jardinería</option>
                    <option value="Limpieza" <%= offer?.categoria === 'Limpieza' ? 'selected' : '' %>>Limpieza</option>
                    <option value="Piscinero" <%= offer?.categoria === 'Piscinero' ? 'selected' : '' %>>Piscinero</option>
                    <option value="Carpintería" <%= offer?.categoria === 'Carpintería' ? 'selected' : '' %>>Carpintería</option>
                    <option value="Mantenimiento" <%= offer?.categoria === 'Mantenimiento' ? 'selected' : '' %>>Mantenimiento</option>
                    <option value="Plomería" <%= offer?.categoria === 'Plomería' ? 'selected' : '' %>>Plomería</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="precioReferencia" class="form-label">Precio *</label>
                  <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" class="form-control" id="precioReferencia" name="precioReferencia" value="<%= offer?.precioReferencia || 0 %>" min="0" step="1" required>
                  </div>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="visible" class="form-label">Estado *</label>
                  <select class="form-select" id="visible" name="visible" required>
                    <option value="true" <%= offer?.visible ? 'selected' : '' %>>Activa</option>
                    <option value="false" <%= !offer?.visible ? 'selected' : '' %>>Inactiva</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="descripcion" class="form-label">Descripción</label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="4"><%= offer?.descripcion || '' %></textarea>
              <div class="invalid-feedback"></div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/ofertas" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Actualizar Oferta
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // SSR: el formulario ya está prellenado; no se requieren peticiones fetch aquí.
});

</script>
