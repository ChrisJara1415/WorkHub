<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Reportes PQRS</h2>
        <a href="/admin/reportes/crear" class="btn btn-primary">
          <i class="bi bi-plus-lg"></i> Nuevo Reporte
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <!-- Buscador y filtros -->
          <form method="GET" class="row g-3 mb-3">
            <div class="col-md-4">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="q" placeholder="Buscar por usuario, título o descripción" value="<%= (typeof q !== 'undefined' && q) ? q : '' %>">
              </div>
            </div>
            <div class="col-md-3">
              <select class="form-select" name="tipo">
                <option value="">Todos los tipos</option>
                <% ['Petición','Queja','Reclamo','Sugerencia','Consulta'].forEach(t => { %>
                  <option value="<%= t %>" <%= (tipo===t) ? 'selected' : '' %>><%= t %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-3">
              <select class="form-select" name="prioridad">
                <option value="">Todas las prioridades</option>
                <% ['Alta','Media','Baja'].forEach(p => { %>
                  <option value="<%= p %>" <%= (prioridad===p) ? 'selected' : '' %>><%= p %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2">
              <select class="form-select" name="estado">
                <option value="">Todos los estados</option>
                <% ['Abierto','Cerrado','En proceso'].forEach(e => { %>
                  <option value="<%= e %>" <%= (estado===e) ? 'selected' : '' %>><%= e %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-12 text-end">
              <button type="submit" class="btn btn-outline-primary"><i class="bi bi-filter"></i> Filtrar</button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Tipo</th>
                  <th>Título</th>
                  <th>Fecha</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if ((reports || []).length > 0) { %>
                  <% reports.forEach(r => { %>
                    <tr>
                      <td><%= r.usuario && r.usuario.nombre %></td>
                      <td><%= r.tipo %></td>
                      <td><%= r.titulo %></td>
                      <td><%= r.fechaReporte ? new Date(r.fechaReporte).toLocaleDateString('es-CO') : 'N/A' %></td>
                      <td><%= r.estado %></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary btn-view" data-entity="reporte" data-record="<%= encodeURIComponent(JSON.stringify({
                          id: r._id,
                          usuario: r.usuario && r.usuario.nombre,
                          tipo: r.tipo,
                          titulo: r.titulo,
                          descripcion: r.descripcion,
                          fecha: r.fechaReporte ? new Date(r.fechaReporte).toLocaleString('es-CO') : 'N/A',
                          prioridad: r.prioridad,
                          estado: r.estado
                        })) %>"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" href="/admin/reportes/<%= r._id %>/editar"><i class="bi bi-pencil-square"></i></a>
                        <a class="btn btn-sm btn-outline-danger btn-delete" data-entity="reporte" data-action="/admin/reportes/<%= r._id %>"><i class="bi bi-trash"></i></a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="text-center text-muted">No hay reportes</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (pagination && pagination.totalPages > 1) { %>
            <nav aria-label="Paginación de reportes">
              <ul class="pagination justify-content-center">
                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                  <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>&limit=<%= pagination.limit || 10 %><%= q ? '&q=' + encodeURIComponent(q) : '' %><%= tipo ? '&tipo=' + encodeURIComponent(tipo) : '' %><%= prioridad ? '&prioridad=' + encodeURIComponent(prioridad) : '' %><%= estado ? '&estado=' + encodeURIComponent(estado) : '' %>"><%= p %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
 
