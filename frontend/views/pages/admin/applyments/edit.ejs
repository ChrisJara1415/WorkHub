<% layout('layout') %>

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Editar Postulación</h2>
        <a href="/admin/applyments" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Volver
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <form id="editApplymentForm">
            <input type="hidden" id="applymentId" name="id">
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleado_id" class="form-label">Empleado *</label>
                  <select class="form-select" id="empleado_id" name="empleado_id" required>
                    <option value="">Seleccionar empleado...</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="oferta_id" class="form-label">Oferta *</label>
                  <select class="form-select" id="oferta_id" name="oferta_id" required>
                    <option value="">Seleccionar oferta...</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="fecha_postulacion" class="form-label">Fecha de Postulación *</label>
                  <input type="date" class="form-control" id="fecha_postulacion" name="fecha_postulacion" required>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="estado" class="form-label">Estado *</label>
                  <select class="form-select" id="estado" name="estado" required>
                    <option value="pendiente">Pendiente</option>
                    <option value="aceptada">Aceptada</option>
                    <option value="rechazada">Rechazada</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="mensaje" class="form-label">Mensaje</label>
              <textarea class="form-control" id="mensaje" name="mensaje" rows="4" placeholder="Mensaje del empleado al postularse..."></textarea>
              <div class="invalid-feedback"></div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/applyments" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Actualizar Postulación
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const applymentId = window.location.pathname.split('/').pop();
  loadEmployees();
  loadOffers();
  loadApplyment(applymentId);
  
  document.getElementById('editApplymentForm').addEventListener('submit', handleSubmit);
});

async function loadEmployees() {
  try {
    const response = await fetch('/admin/api/users?role=empleado');
    const data = await response.json();
    
    if (data.success) {
      const select = document.getElementById('empleado_id');
      data.data.users.forEach(user => {
        const option = document.createElement('option');
        option.value = user.id;
        option.textContent = `${user.nombres} ${user.apellidos}`;
        select.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error al cargar empleados:', error);
  }
}

async function loadOffers() {
  try {
    const response = await fetch('/admin/api/offers');
    const data = await response.json();
    
    if (data.success) {
      const select = document.getElementById('oferta_id');
      data.data.offers.forEach(offer => {
        const option = document.createElement('option');
        option.value = offer.id;
        option.textContent = `${offer.servicio} - ${offer.municipio}`;
        select.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error al cargar ofertas:', error);
  }
}

async function loadApplyment(id) {
  try {
    const response = await fetch(`/admin/api/applyments/${id}`);
    const data = await response.json();
    
    if (data.success) {
      const applyment = data.data;
      document.getElementById('applymentId').value = applyment.id;
      document.getElementById('empleado_id').value = applyment.empleado_id;
      document.getElementById('oferta_id').value = applyment.oferta_id;
      document.getElementById('fecha_postulacion').value = applyment.fecha_postulacion ? applyment.fecha_postulacion.split('T')[0] : '';
      document.getElementById('estado').value = applyment.estado;
      document.getElementById('mensaje').value = applyment.mensaje || '';
    } else {
      showAlert('Error al cargar postulación: ' + data.message, 'danger');
    }
  } catch (error) {
    console.error('Error:', error);
    showAlert('Error de conexión al cargar postulación', 'danger');
  }
}

async function handleSubmit(e) {
  e.preventDefault();
  
  const formData = new FormData(e.target);
  const applymentData = Object.fromEntries(formData.entries());
  const applymentId = applymentData.id;
  delete applymentData.id;
  
  try {
    const response = await fetch(`/admin/api/applyments/${applymentId}`, {
      method: 'PUT',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(applymentData)
    });
    
    const data = await response.json();
    
    if (data.success) {
      showAlert('Postulación actualizada exitosamente', 'success');
      setTimeout(() => {
        window.location.href = '/admin/applyments';
      }, 1500);
    } else {
      showAlert('Error al actualizar postulación: ' + data.message, 'danger');
      if (data.errors) {
        showValidationErrors(data.errors);
      }
    }
  } catch (error) {
    console.error('Error:', error);
    showAlert('Error de conexión al actualizar postulación', 'danger');
  }
}
</script>