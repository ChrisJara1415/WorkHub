

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Nueva Postulación</h2>
        <a href="/admin/postulaciones" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Volver
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <form method="POST" action="/admin/postulaciones">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleado_id" class="form-label">Empleado *</label>
                  <select class="form-select" id="empleado_id" name="empleado[idUsuario]" required>
                    <option value="">Seleccionar empleado...</option>
                    <% (empleados || []).forEach(u => { %>
                      <option value="<%= u._id %>" data-nombre="<%= (u.nombres || '') + ' ' + (u.apellidos || '') %>"><%= u.nombres %> <%= u.apellidos %></option>
                    <% }) %>
                  </select>
                  <input type="hidden" id="empleado_nombre" name="empleado[nombre]">
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="oferta_id" class="form-label">Oferta *</label>
                  <select class="form-select" id="oferta_id" name="servicio[idServicio]" required>
                    <option value="">Seleccionar oferta...</option>
                    <% (offers || []).forEach(of => { %>
                      <option value="<%= of._id %>" data-nombre="<%= of.nombreServicio %>"><%= of.nombreServicio %> (<%= of.municipio?.nombre %>)</option>
                    <% }) %>
                  </select>
                  <input type="hidden" id="servicio_nombre" name="servicio[nombreServicio]">
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="fechaPostulacion" class="form-label">Fecha de Postulación *</label>
                  <input type="date" class="form-control" id="fechaPostulacion" name="fechaPostulacion" value="<%= new Date().toISOString().split('T')[0] %>" required>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="estado" class="form-label">Estado *</label>
                  <select class="form-select" id="estado" name="estado" required>
                    <option value="Pendiente" selected>Pendiente</option>
                    <option value="Aceptada">Aceptada</option>
                    <option value="Rechazada">Rechazada</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/postulaciones" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Guardar Postulación
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// Mantener sincronizados los campos de nombre requeridos por el backend
document.addEventListener('DOMContentLoaded', function () {
  const selEmp = document.getElementById('empleado_id')
  const inpEmpNom = document.getElementById('empleado_nombre')
  const selOf = document.getElementById('oferta_id')
  const inpServNom = document.getElementById('servicio_nombre')

  function updateEmpNom() {
    const opt = selEmp.options[selEmp.selectedIndex]
    inpEmpNom.value = opt ? opt.getAttribute('data-nombre') || '' : ''
  }
  function updateServNom() {
    const opt = selOf.options[selOf.selectedIndex]
    inpServNom.value = opt ? opt.getAttribute('data-nombre') || '' : ''
  }
  selEmp.addEventListener('change', updateEmpNom)
  selOf.addEventListener('change', updateServNom)
  updateEmpNom(); updateServNom();
})
</script>