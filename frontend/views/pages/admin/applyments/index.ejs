

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Postulaciones</h2>
        <a href="/admin/postulaciones/crear" class="btn btn-primary">
          <i class="bi bi-plus-lg"></i> Nueva Postulación
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <!-- Buscador y filtros -->
          <form method="GET" class="row g-3 mb-3">
            <div class="col-md-6">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="q" placeholder="Buscar por servicio o empleado" value="<%= (typeof q !== 'undefined' && q) ? q : '' %>">
              </div>
            </div>
            <div class="col-md-4">
              <select class="form-select" name="estado">
                <option value="">Todos los estados</option>
                <% ['Aceptada','Pendiente','Rechazada'].forEach(e => { %>
                  <option value="<%= e %>" <%= (estado===e) ? 'selected' : '' %>><%= e %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2 d-grid">
              <button type="submit" class="btn btn-outline-primary"><i class="bi bi-filter"></i></button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
              <thead>
                <tr>
                  <th>Empleado</th>
                  <th>Oferta</th>
                  <th>Fecha Postulación</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if ((applyments || []).length > 0) { %>
                  <% applyments.forEach(a => { %>
                    <tr>
                      <td><%= a.empleado && a.empleado.nombre %></td>
                      <td><%= a.servicio && a.servicio.nombreServicio %></td>
                      <td><%= a.fechaPostulacion ? new Date(a.fechaPostulacion).toLocaleDateString('es-CO') : 'N/A' %></td>
                      <td><span class="badge <%= a.estado === 'Aceptada' ? 'text-bg-success' : (a.estado === 'Pendiente' ? 'text-bg-warning' : 'text-bg-danger') %>"><%= a.estado %></span></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary btn-view" data-entity="postulación" data-record="<%= encodeURIComponent(JSON.stringify({
                          id: a._id,
                          empleado: a.empleado && a.empleado.nombre,
                          servicio: a.servicio && a.servicio.nombreServicio,
                          fechaPostulación: a.fechaPostulacion ? new Date(a.fechaPostulacion).toLocaleString('es-CO') : 'N/A',
                          estado: a.estado
                        })) %>"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" href="/admin/postulaciones/<%= a._id %>/editar"><i class="bi bi-pencil-square"></i></a>
                        <a class="btn btn-sm btn-outline-danger btn-delete" data-entity="postulación" data-action="/admin/postulaciones/<%= a._id %>"><i class="bi bi-trash"></i></a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="text-center text-muted">No hay postulaciones para mostrar</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (pagination && pagination.totalPages > 1) { %>
            <nav aria-label="Paginación de postulaciones">
              <ul class="pagination justify-content-center">
                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                  <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>&limit=<%= pagination.limit || 10 %><%= q ? '&q=' + encodeURIComponent(q) : '' %><%= estado ? '&estado=' + encodeURIComponent(estado) : '' %>"><%= p %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
