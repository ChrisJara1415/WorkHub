

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Editar Contrato</h2>
        <a href="/admin/contratos" class="btn btn-secondary">
          <i class="bi bi-arrow-left"></i> Volver
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <form method="POST" action="/admin/contratos/<%= (contract && (contract._id || contract.id)) %>?_method=PUT">
            <input type="hidden" name="id" value="<%= (contract && (contract._id || contract.id)) %>">
            
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="oferta_id" class="form-label">Oferta *</label>
                  <select class="form-select" id="oferta_id" name="oferta[idOferta]" required>
                    <option value="">Seleccionar oferta...</option>
                    <% (offers || []).forEach(of => { %>
                      <option value="<%= of._id %>" <%= (contract?.oferta?.idOferta?.toString() === of._id?.toString()) ? 'selected' : '' %>><%= of.nombreServicio %></option>
                    <% }) %>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleado_id" class="form-label">Empleado *</label>
                  <select class="form-select" id="empleado_id" name="empleado[idUsuario]" required>
                    <option value="">Seleccionar empleado...</option>
                    <% (empleados || []).forEach(u => { %>
                      <option value="<%= u._id %>" <%= (contract?.empleado?.idUsuario?.toString() === u._id?.toString()) ? 'selected' : '' %>><%= u.nombres %> <%= u.apellidos %></option>
                    <% }) %>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleador_id" class="form-label">Empleador *</label>
                  <select class="form-select" id="empleador_id" name="empleador[idUsuario]" required>
                    <option value="">Seleccionar empleador...</option>
                    <% (empleadores || []).forEach(u => { %>
                      <option value="<%= u._id %>" <%= (contract?.empleador?.idUsuario?.toString() === u._id?.toString()) ? 'selected' : '' %>><%= u.nombres %> <%= u.apellidos %></option>
                    <% }) %>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="estado" class="form-label">Estado *</label>
                  <select class="form-select" id="estado" name="estado" required>
                    <option value="Activo" <%= contract?.estado === 'Activo' ? 'selected' : '' %>>Activo</option>
                    <option value="Inactivo" <%= contract?.estado === 'Inactivo' ? 'selected' : '' %>>Inactivo</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="fechaInicio" class="form-label">Fecha de Inicio *</label>
                  <input type="date" class="form-control" id="fechaInicio" name="fechaInicio" value="<%= contract?.fechaInicio ? new Date(contract.fechaInicio).toISOString().split('T')[0] : '' %>" required>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="fechaFin" class="form-label">Fecha de Fin</label>
                  <input type="date" class="form-control" id="fechaFin" name="fechaFin" value="<%= contract?.fechaFin ? new Date(contract.fechaFin).toISOString().split('T')[0] : '' %>">
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/contratos" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Actualizar Contrato
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

