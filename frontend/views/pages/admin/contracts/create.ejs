

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Nuevo Contrato</h2>
        <a href="/admin/contratos" class="btn btn-secondary">
          <i class="fas fa-arrow-left"></i> Volver
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <form id="createContractForm">
            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="oferta_id" class="form-label">Oferta *</label>
                  <select class="form-select" id="oferta_id" name="oferta_id" required>
                    <option value="">Seleccionar oferta...</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleado_id" class="form-label">Empleado *</label>
                  <select class="form-select" id="empleado_id" name="empleado_id" required>
                    <option value="">Seleccionar empleado...</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="empleador_id" class="form-label">Empleador *</label>
                  <select class="form-select" id="empleador_id" name="empleador_id" required>
                    <option value="">Seleccionar empleador...</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="estado" class="form-label">Estado *</label>
                  <select class="form-select" id="estado" name="estado" required>
                    <option value="activo">Activo</option>
                    <option value="completado">Completado</option>
                    <option value="cancelado">Cancelado</option>
                  </select>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="row">
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="fecha_inicio" class="form-label">Fecha de Inicio *</label>
                  <input type="date" class="form-control" id="fecha_inicio" name="fecha_inicio" required>
                  <div class="invalid-feedback"></div>
                </div>
              </div>
              <div class="col-md-6">
                <div class="mb-3">
                  <label for="fecha_fin" class="form-label">Fecha de Fin</label>
                  <input type="date" class="form-control" id="fecha_fin" name="fecha_fin">
                  <div class="invalid-feedback"></div>
                </div>
              </div>
            </div>

            <div class="mb-3">
              <label for="descripcion" class="form-label">Descripción</label>
              <textarea class="form-control" id="descripcion" name="descripcion" rows="4"></textarea>
              <div class="invalid-feedback"></div>
            </div>

            <div class="d-flex justify-content-end gap-2">
              <a href="/admin/contratos" class="btn btn-secondary">Cancelar</a>
              <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Guardar Contrato
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  loadOffers();
  loadEmployees();
  loadEmployers();
  
  document.getElementById('createContractForm').addEventListener('submit', handleSubmit);
});

async function loadOffers() {
  try {
    const response = await fetch('/admin/offers?estado=activa');
    const data = await response.json();
    
    if (data.success) {
      const select = document.getElementById('oferta_id');
      data.data.offers.forEach(offer => {
        const option = document.createElement('option');
        option.value = offer.id;
        option.textContent = `${offer.servicio} - ${offer.municipio}`;
        select.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error al cargar ofertas:', error);
  }
}

async function loadEmployees() {
  try {
    const response = await fetch('/admin/users?role=empleado');
    const data = await response.json();
    
    if (data.success) {
      const select = document.getElementById('empleado_id');
      data.data.users.forEach(user => {
        const option = document.createElement('option');
        option.value = user.id;
        option.textContent = `${user.nombres} ${user.apellidos}`;
        select.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error al cargar empleados:', error);
  }
}

async function loadEmployers() {
  try {
    const response = await fetch('/admin/users?role=empleador');
    const data = await response.json();
    
    if (data.success) {
      const select = document.getElementById('empleador_id');
      data.data.users.forEach(user => {
        const option = document.createElement('option');
        option.value = user.id;
        option.textContent = `${user.nombres} ${user.apellidos}`;
        select.appendChild(option);
      });
    }
  } catch (error) {
    console.error('Error al cargar empleadores:', error);
  }
}

async function handleSubmit(e) {
  e.preventDefault();
  
  const formData = new FormData(e.target);
  const contractData = Object.fromEntries(formData.entries());
  
  try {
    const response = await fetch('/admin/contratos', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(contractData)
    });
    
    const data = await response.json();
    
    if (data.success) {
      showAlert('Contrato creado exitosamente', 'success');
      setTimeout(() => {
        window.location.href = '/admin/contratos';
      }, 1500);
    } else {
      showAlert('Error al crear contrato: ' + data.message, 'danger');
      if (data.errors) {
        showValidationErrors(data.errors);
      }
    }
  } catch (error) {
    console.error('Error:', error);
    showAlert('Error de conexión al crear contrato', 'danger');
  }
}
</script>
