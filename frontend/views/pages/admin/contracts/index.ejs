

<div class="container-fluid">
  <div class="row">
    <div class="col-12">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Contratos</h2>
        <a href="/admin/contratos/crear" class="btn btn-primary">
          <i class="bi bi-plus-lg"></i> Nuevo Contrato
        </a>
      </div>

      <div class="card">
        <div class="card-body">
          <!-- Buscador y filtros -->
          <form method="GET" class="row g-3 mb-3">
            <div class="col-md-6">
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" class="form-control" name="q" placeholder="Buscar por oferta, empleado o empleador" value="<%= (typeof q !== 'undefined' && q) ? q : '' %>">
              </div>
            </div>
            <div class="col-md-4">
              <select class="form-select" name="estado">
                <option value="">Todos los estados</option>
                <% ['Activo','Inactivo'].forEach(e => { %>
                  <option value="<%= e %>" <%= (estado===e) ? 'selected' : '' %>><%= e %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-md-2 d-grid">
              <button type="submit" class="btn btn-outline-primary"><i class="bi bi-filter"></i></button>
            </div>
          </form>

          <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
              <thead>
                <tr>
                  <th>Oferta</th>
                  <th>Empleado</th>
                  <th>Empleador</th>
                  <th>Inicio</th>
                  <th>Fin</th>
                  <th>Estado</th>
                  <th class="text-end">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% if ((contracts || []).length > 0) { %>
                  <% contracts.forEach(c => { %>
                    <tr>
                      <td><%= c.oferta && c.oferta.nombreOferta %></td>
                      <td><%= c.empleado && c.empleado.nombre %></td>
                      <td><%= c.empleador && c.empleador.nombre %></td>
                      <td><%= c.fechaInicio ? new Date(c.fechaInicio).toLocaleDateString('es-CO') : 'N/A' %></td>
                      <td><%= c.fechaFin ? new Date(c.fechaFin).toLocaleDateString('es-CO') : 'N/A' %></td>
                      <td><span class="badge <%= c.estado === 'Activo' ? 'text-bg-success' : 'text-bg-secondary' %>"><%= c.estado %></span></td>
                      <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary btn-view" data-entity="contrato" data-record="<%= encodeURIComponent(JSON.stringify({
                          id: c._id,
                          oferta: c.oferta && c.oferta.nombreOferta,
                          empleado: c.empleado && c.empleado.nombre,
                          empleador: c.empleador && c.empleador.nombre,
                          inicio: c.fechaInicio ? new Date(c.fechaInicio).toLocaleString('es-CO') : 'N/A',
                          fin: c.fechaFin ? new Date(c.fechaFin).toLocaleString('es-CO') : 'N/A',
                          estado: c.estado
                        })) %>"><i class="bi bi-eye"></i></a>
                        <a class="btn btn-sm btn-outline-primary" href="/admin/contratos/<%= c._id %>/editar"><i class="bi bi-pencil-square"></i></a>
                        <a class="btn btn-sm btn-outline-danger btn-delete" data-entity="contrato" data-action="/admin/contratos/<%= c._id %>"><i class="bi bi-trash"></i></a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center text-muted">No hay contratos para mostrar</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <% if (pagination && pagination.totalPages > 1) { %>
            <nav aria-label="Paginación de contratos">
              <ul class="pagination justify-content-center">
                <% for (let p = 1; p <= pagination.totalPages; p++) { %>
                  <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                    <a class="page-link" href="?page=<%= p %>&limit=<%= pagination.limit || 10 %><%= q ? '&q=' + encodeURIComponent(q) : '' %><%= estado ? '&estado=' + encodeURIComponent(estado) : '' %>"><%= p %></a>
                  </li>
                <% } %>
              </ul>
            </nav>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
