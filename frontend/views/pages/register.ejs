<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Registro | WorkHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/styles/workhub-tokens.css" rel="stylesheet" />
    <link href="/styles/common.css" rel="stylesheet" />
    <style>
        body {
            background: var(--wh-blankest);
        }

        .card {
            border: 0;
            box-shadow: 0 4px 14px rgba(0, 0, 0, .08);
        }

        .form-control.is-valid {
            border-color: #198754;
        }

        .form-control.is-invalid {
            border-color: #dc3545;
        }

        .password-hint {
            font-size: .75rem;
        }

        .brand-gradient {
            background: var(--wh-gradient-blue-teal);
        }

        .fw-brand {
            color: var(--wh-blue);
        }

        /* Use Bootstrap 5 button CSS variables for consistent theming */
        .btn-primary {
            --bs-btn-color: #fff;
            --bs-btn-bg: var(--wh-orange-soft);
            --bs-btn-border-color: var(--wh-orange-soft);
            --bs-btn-hover-bg: var(--wh-orange);
            --bs-btn-hover-border-color: var(--wh-orange);
            --bs-btn-active-bg: var(--wh-orange);
            --bs-btn-active-border-color: var(--wh-orange);
            --bs-btn-disabled-bg: var(--wh-orange-soft);
            --bs-btn-disabled-border-color: var(--wh-orange-soft);
        }

        .form-floating>label {
            color: var(--wh-grey);
        }

        .availability-msg {
            font-size: .75rem;
        }
    </style>
</head>

<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-xl-7">
                <div class="card p-4 p-md-5 rounded-4">
                    <div class="text-center mb-4">
                        <h1 class="h3 fw-bold mb-1">Crea tu cuenta</h1>
                        <p class="text-muted mb-0">Conecta talento con oportunidades</p>
                    </div>
                    <form id="registerForm" novalidate>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="nombres" name="nombres"
                                        placeholder="Nombres" required />
                                    <label for="nombres">Nombres</label>
                                    <div class="invalid-feedback" data-field="nombres"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="text" class="form-control" id="apellidos" name="apellidos"
                                        placeholder="Apellidos" required />
                                    <label for="apellidos">Apellidos</label>
                                    <div class="invalid-feedback" data-field="apellidos"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="email" class="form-control" id="email" name="email"
                                        placeholder="correo@dominio.com" required />
                                    <label for="email">Correo electrónico</label>
                                    <div class="availability-msg" id="emailAvailability"></div>
                                    <div class="invalid-feedback" data-field="email"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="tel" class="form-control" id="telefono" name="telefono"
                                        placeholder="3XXXXXXXXX" required />
                                    <label for="telefono">Teléfono</label>
                                    <div class="availability-msg" id="telAvailability"></div>
                                    <div class="invalid-feedback" data-field="telefono"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating position-relative">
                                    <input type="password" class="form-control" id="password" name="password"
                                        placeholder="Contraseña" required />
                                    <label for="password">Contraseña</label>
                                    <button type="button" id="toggleRegPwd" class="btn btn-sm btn-outline-secondary position-absolute end-0 top-50 translate-middle-y me-2">Ver</button>
                                    <div class="invalid-feedback" data-field="password"></div>
                                </div>
                                <div class="password-hint text-muted mt-1" id="passwordHint">Mínimo 8 caracteres,
                                    mayúscula, minúscula y número.</div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating position-relative">
                                    <input type="password" class="form-control" id="confirmPassword"
                                        name="confirmPassword" placeholder="Confirmar contraseña" required />
                                    <label for="confirmPassword">Confirmar contraseña</label>
                                    <button type="button" id="toggleRegPwd2" class="btn btn-sm btn-outline-secondary position-absolute end-0 top-50 translate-middle-y me-2">Ver</button>
                                    <div class="invalid-feedback" data-field="confirmPassword"></div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <select class="form-select" id="rol" name="rol" required>
                                        <option value="" selected disabled>Selecciona un rol</option>
                                        <option value="empleado">Empleado</option>
                                        <option value="empleador">Empleador</option>
                                    </select>
                                    <label for="rol">Rol</label>
                                    <div class="invalid-feedback" data-field="rol"></div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-4 d-grid gap-2">
                            <button class="btn btn-primary py-3" type="submit" id="submitBtn">
                                <span class="spinner-border spinner-border-sm me-2 d-none" id="loadingSpinner"></span>
                                Crear cuenta
                            </button>
                            <p class="text-center small mb-0">¿Ya tienes una cuenta? <a href="#" class="fw-semibold"
                                    onclick="document.getElementById('modalLogin')?.showModal();return false;">Inicia
                                    sesión</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="/scripts/register.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function(){
                const p1 = document.getElementById('password');
                const p2 = document.getElementById('confirmPassword');
                document.getElementById('toggleRegPwd')?.addEventListener('click', function(){ p1.type = p1.type==='password'?'text':'password'; this.textContent = p1.type==='password'?'Ver':'Ocultar'; });
                document.getElementById('toggleRegPwd2')?.addEventListener('click', function(){ p2.type = p2.type==='password'?'text':'password'; this.textContent = p2.type==='password'?'Ver':'Ocultar'; });
            });
        </script>
</body>

</html>