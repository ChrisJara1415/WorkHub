<!DOCTYPE html>
<html lang="es">
<%- include('../../partials/head') %>

    <body class="bk-angel-blank">
        <%- include('../../partials/navbar') %>
            <main class="container py-4">
                <!-- Hero Search -->
                <section class="py-5" style="background:linear-gradient(180deg,#eef4fb, #ffffff);">
                    <div class="container">
                        <div class="text-center mb-4">
                            <h1 class="fw-bold wh-title">Encuentra tu próximo trabajo</h1>
                            <p class="text-muted">Explora cientos de ofertas en mantenimiento, limpieza
                                y servicios auxiliares</p>
                        </div>
                        <div class="d-flex gap-2 mx-auto" style="max-width:820px;">
                            <div class="input-group input-group-lg shadow-sm">
                                <span class="input-group-text bg-white border-0"><i class="bi bi-search"></i></span>
                                <input id="searchInput" type="text" class="form-control border-0"
                                    placeholder="Buscar por título, categoría o ubicación" />
                            </div>
                            <button id="btnSearch" type="button"
                                class="btn btn-warning btn-lg fw-semibold">Buscar</button>
                        </div>
                    </div>
                </section>

                <!-- Categorías populares -->
                <section class="py-5" style="background:#f3f7fb;">
                    <div class="container">
                        <h2 class="h4 text-center mb-4">Categorías Populares</h2>
                        <div class="row g-3 justify-content-center" id="categoriesGrid"></div>
                    </div>
                </section>

                <!-- Ofertas disponibles -->
                <section class="py-4" style="background:#f8fafc;">
                    <div class="container">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="m-0">Ofertas Disponibles</h3>
                            <div class="d-flex align-items-center gap-2">
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary dropdown-toggle" type="button"
                                        id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-funnel"></i> Filtrar
                                    </button>
                                    <ul class="dropdown-menu" aria-labelledby="filterDropdown">
                                        <li class="dropdown-header">Categoría</li>
                                        <li><a class="dropdown-item" data-category="Todas" href="#">Todas</a>
                                        </li>
                                        <li><a class="dropdown-item" data-category="Jardinería" href="#">Jardinería</a>
                                        </li>
                                        <li><a class="dropdown-item" data-category="Limpieza" href="#">Limpieza</a></li>
                                        <li><a class="dropdown-item" data-category="Piscinero" href="#">Piscinero</a>
                                        </li>
                                        <li><a class="dropdown-item" data-category="Carpintería"
                                                href="#">Carpintería</a></li>
                                        <li><a class="dropdown-item" data-category="Mantenimiento"
                                                href="#">Mantenimiento</a></li>
                                        <li><a class="dropdown-item" data-category="Plomería" href="#">Plomería</a></li>
                                        <li>
                                            <hr class="dropdown-divider" />
                                        </li>
                                        <li class="dropdown-header">Ordenar por</li>
                                        <li><a class="dropdown-item" data-sort="recientes" href="#">Más
                                                recientes</a></li>
                                        <li><a class="dropdown-item" data-sort="antiguos" href="#">Más
                                                antiguos</a></li>
                                    </ul>
                                </div>
                                <div class="btn-group" role="group" aria-label="Vista">
                                    <button class="btn btn-outline-secondary active" id="gridViewBtn" title="Cuadrícula"
                                        type="button"><i class="bi bi-grid-3x3-gap"></i></button>
                                    <button class="btn btn-outline-secondary" id="listViewBtn" title="Lista"
                                        type="button"><i class="bi bi-list-ul"></i></button>
                                </div>
                            </div>
                        </div>

                        <div id="offers" class="row g-3" aria-live="polite"></div>
                    </div>
                </section>

            </main>

            <!-- Modal de detalles de oferta -->
            <div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered modal-lg">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="jobDetailsModalLabel">Detalles de la Oferta</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="jobDetailsBody"></div>
                        <div class="modal-footer">
                            <button type="button" id="closeDetailsBtn" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                            <button type="button" id="applyBtn" class="btn btn-warning">Postularme</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Toasts -->
            <div class="toast-container position-fixed bottom-0 end-0 p-3" id="toastContainer"></div>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
                crossorigin="anonymous"></script>
            <script>
                // Usuario actual para reglas de UI (auto-postulación / ya postulada)
                // Se inyecta como JSON seguro y se parsea para evitar errores de sintaxis
                (function(){
                    const el = document.createElement('script');
                    el.id = 'CURRENT_USER_DATA';
                    el.type = 'application/json';
                    el.textContent = `<%- JSON.stringify(user || null) %>`;
                    document.currentScript.before(el);
                })();
                window.CURRENT_USER = (()=>{ try { return JSON.parse(document.getElementById('CURRENT_USER_DATA')?.textContent||'null') } catch { return null } })();
                const toast = (msg, type = 'success') => {
                    const container = document.getElementById('toastContainer');
                    const bg = type === 'success' ? 'text-bg-success' : 'text-bg-danger'
                    const el = document.createElement('div');
                    el.className = `toast align-items-center ${bg}`;
                    el.setAttribute('role', 'alert'); el.setAttribute('aria-live', 'assertive'); el.setAttribute('aria-atomic', 'true');
                    el.innerHTML = `<div class="d-flex"><div class="toast-body">${msg}</div><button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button></div>`;
                    container.appendChild(el); new bootstrap.Toast(el, { delay: 3000 }).show(); el.addEventListener('hidden.bs.toast', () => el.remove());
                }

                async function api(path, options = {}) {
                    const res = await fetch(`/api${path}`, { headers: { 'Content-Type': 'application/json' }, credentials: 'include', ...options });
                    const body = await res.json().catch(()=>({}))
                    if (!res.ok) throw new Error(body.message || 'Error de red')
                    return body;
                }

                const CATEGORIES = [
                    { name: 'Jardinería', icon: 'bi-tree' },
                    { name: 'Limpieza', icon: 'bi-droplet' },
                    { name: 'Piscinero', icon: 'bi-water' },
                    { name: 'Carpintería', icon: 'bi-hammer' },
                    { name: 'Mantenimiento', icon: 'bi-wrench' },
                    { name: 'Plomería', icon: 'bi-tools' }
                ];

                function renderCategories() {
                    const wrap = document.getElementById('categoriesGrid');
                    wrap.innerHTML = CATEGORIES.map(c => `
                    <div class="col-6 col-md-4 col-lg-2">
                        <button class="w-100 btn btn-light py-3 shadow-sm category-btn" type="button" data-category="${c.name}">
                            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width:42px;height:42px;background:#eef4fb;">
                                <i class="bi ${c.icon}"></i>
                            </div>
                            <div class="fw-semibold">${c.name}</div>
                        </button>
                    </div>
                `).join('');
                }

                let currentCategory = 'Todas';
                let currentSort = 'recientes';
                let currentView = 'grid';

                function currency(n) { try { return (n || n === 0) ? Number(n).toLocaleString('es-CO', { style: 'currency', currency: 'COP', maximumFractionDigits: 0 }) : '—' } catch { return n } }
                function formatDate(d) { try { return new Date(d).toLocaleDateString('es-CO') } catch { return d || '—' } }

                function filteredOffers() {
                    let arr = [...(window._OFFERS || [])];
                    const q = document.getElementById('searchInput').value.trim().toLowerCase();
                    if (q) arr = arr.filter(o => `${o.nombreServicio || ''} ${o.descripcion || ''} ${o.categoria || ''} ${o.municipio?.nombre || ''}`.toLowerCase().includes(q));
                    if (currentCategory && currentCategory !== 'Todas') arr = arr.filter(o => o.categoria === currentCategory)
                    arr.sort((a, b) => {
                        const da = new Date(a.fechaCreacion).getTime();
                        const db = new Date(b.fechaCreacion).getTime();
                        return currentSort === 'recientes' ? db - da : da - db;
                    })
                    return arr;
                }

                            function offerCard(o) {
                                const img = (Array.isArray(o.imagenes) && o.imagenes[0]) ? o.imagenes[0] : '/img/oficios/jardin.jpg';
                    const empleador = o.empleador?.nombre || 'Empleador';
                    return `
                <div class="card h-100 shadow-sm">
                    <div class="w-100"><img src="${img}" class="card-img-fixed" alt="${o.nombreServicio}"></div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">${o.nombreServicio}</h5>
                            <span class="badge text-bg-light border">${o.categoria}</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 text-muted small mb-2">
                            <i class="bi bi-person-circle"></i>
                            <span>${empleador}</span>
                        </div>
                        <div class="d-flex flex-wrap gap-3 small text-muted mb-2">
                            <span><i class="bi bi-geo-alt"></i> ${o.municipio?.nombre || '—'}</span>
                            <span><i class="bi bi-cash"></i> ${currency(o.precioReferencia)}</span>
                            <span><i class="bi bi-calendar-event"></i> Hasta: ${formatDate(o.fechaLimite)}</span>
                        </div>
                        <p class="mb-3 text-truncate" style="-webkit-line-clamp:2; display:-webkit-box; -webkit-box-orient:vertical;">${o.descripcion}</p>
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">Publicado: ${formatDate(o.fechaCreacion)}</small>
                            <button class="btn btn-warning" type="button" data-offer='${encodeURIComponent(JSON.stringify(o))}'>Ver detalles</button>
                        </div>
                    </div>
                </div>`
                }

                function offerListItem(o) {
                    return `
                <div class="list-group-item py-3">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">${o.nombreServicio}</h5>
                        <small class="text-muted">${formatDate(o.fechaCreacion)}</small>
                    </div>
                    <p class="mb-1 text-muted">${o.descripcion}</p>
                    <small><i class="bi bi-geo-alt"></i> ${o.municipio?.nombre || '—'} · <i class="bi bi-cash"></i> ${currency(o.precioReferencia)} · <i class="bi bi-calendar-event"></i> Hasta: ${formatDate(o.fechaLimite)}</small>
                    <div class="mt-2 text-end">
                        <button class="btn btn-sm btn-warning" type="button" data-offer='${encodeURIComponent(JSON.stringify(o))}'>Ver detalles</button>
                    </div>
                </div>`
                }

                function renderOffers() {
                    const grid = document.getElementById('offers');
                    const arr = filteredOffers();
                    if (currentView === 'grid') {
                        grid.className = 'row g-3';
                        grid.innerHTML = arr.map(o => `<div class="col-12 col-md-6 col-lg-4">${offerCard(o)}</div>`).join('');
                    } else {
                        grid.className = 'list-group';
                        grid.innerHTML = arr.map(o => offerListItem(o)).join('');
                    }
                }

                async function loadOffers() {
                    try {
                        const data = await api('/ofertas');
                        window._OFFERS = Array.isArray(data?.data) ? data.data : (data?.offers || []);
                        renderOffers();
                    } catch (e) { console.error(e) }
                }

                // Handlers
                document.getElementById('btnSearch').addEventListener('click', (e) => { e.preventDefault(); renderOffers(); });
                document.getElementById('searchInput').addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); renderOffers(); } });
                document.addEventListener('click', (e) => {
                    const catBtn = e.target.closest('.category-btn');
                    if (catBtn) { e.preventDefault(); currentCategory = catBtn.dataset.category; renderOffers(); }
                    const filterItem = e.target.closest('.dropdown-item');
                    if (filterItem && filterItem.dataset.category) { e.preventDefault(); currentCategory = filterItem.dataset.category; renderOffers(); }
                    if (filterItem && filterItem.dataset.sort) { e.preventDefault(); currentSort = filterItem.dataset.sort; renderOffers(); }
                    const gridBtn = e.target.closest('#gridViewBtn');
                    const listBtn = e.target.closest('#listViewBtn');
                    if (gridBtn) { e.preventDefault(); currentView = 'grid'; gridBtn.classList.add('active'); document.getElementById('listViewBtn').classList.remove('active'); renderOffers(); }
                    if (listBtn) { e.preventDefault(); currentView = 'list'; listBtn.classList.add('active'); document.getElementById('gridViewBtn').classList.remove('active'); renderOffers(); }
                });

                document.addEventListener('click', async (e) => {
                    const btn = e.target.closest('button[data-offer]');
                    if (!btn) return;
                    e.preventDefault();
                    const offer = JSON.parse(decodeURIComponent(btn.getAttribute('data-offer')));
                    const me = (window.CURRENT_USER && (window.CURRENT_USER._id || window.CURRENT_USER.sub)) || null;
                    document.getElementById('jobDetailsBody').innerHTML = `
                    <div class="mb-3">
                        <h4 class="mb-1">${offer.nombreServicio || offer.nombre || offer.titulo || '—'}</h4>
                        <div class="d-flex gap-3 small text-muted">
                            <span><i class="bi bi-person-circle"></i> ${offer.empleador?.nombre || 'Empleador'}</span>
                            <span><i class="bi bi-geo-alt"></i> ${offer.municipio?.nombre || '—'}</span>
                            <span><i class="bi bi-cash"></i> ${currency(offer.precioReferencia)}</span>
                            <span><i class="bi bi-calendar-event"></i> Hasta: ${formatDate(offer.fechaLimite)}</span>
                        </div>
                    </div>
                    <hr/>
                    <div class="row g-3">
                        <div class="col-12">
                            <h6>Descripción</h6>
                            <p class="mb-0">${offer.descripcion || offer.detalle || '—'}</p>
                        </div>
                        <div class="col-12">
                            <h6>Requisitos</h6>
                            <p class="mb-0">${offer.detalleRequerimiento || '—'}</p>
                        </div>
                        <div class="col-12">
                            <h6>Detalles adicionales</h6>
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Ubicación:</dt><dd class="col-sm-8">${offer.municipio?.nombre || '—'}</dd>
                                <dt class="col-sm-4">Categoría:</dt><dd class="col-sm-8">${offer.categoria || '—'}</dd>
                                <dt class="col-sm-4">Salario:</dt><dd class="col-sm-8">${currency(offer.precioReferencia)}</dd>
                                <dt class="col-sm-4">Fecha límite:</dt><dd class="col-sm-8">${formatDate(offer.fechaLimite)}</dd>
                            </dl>
                        </div>
                    </div>`;
                    const modal = new bootstrap.Modal(document.getElementById('jobDetailsModal'));
                    modal.show();
                    const apply = document.getElementById('applyBtn');
                    const closeBtn = document.getElementById('closeDetailsBtn');

                    // Estado inicial de botones
                    apply.disabled = false; apply.classList.remove('btn-secondary'); apply.classList.add('btn-warning'); apply.textContent = 'Postularme';

                    // Determinar si es su propia oferta o ya se postuló
                    let yaPostulado = false; let esPropia = false;
                    try {
                        esPropia = me && String(offer?.empleador?.idUsuario || '') === String(me);
                        const resp = await api('/postulaciones');
                        const arr = Array.isArray(resp?.data) ? resp.data : [];
                        yaPostulado = !!arr.find(a => String(a?.empleado?.idUsuario||'')===String(me||'') && String(a?.servicio?.idServicio||'')===String(offer._id));
                    } catch { /* sin bloqueo */ }

                    if (esPropia) {
                        // No permitir postularse a la propia oferta: solo botón deshabilitado
                        apply.disabled = true; apply.classList.remove('btn-warning'); apply.classList.add('btn-secondary'); apply.textContent = 'Tu oferta';
                    } else if (yaPostulado) {
                        // Ya se postuló: mostrar toast y deshabilitar botón
                        apply.disabled = true; apply.classList.remove('btn-warning'); apply.classList.add('btn-secondary'); apply.textContent = 'Postulado';
                        toast('Te postulaste correctamente', 'success');
                    }

                    apply.onclick = async () => {
                        try {
                            const payload = { servicio: { idServicio: offer._id, nombreServicio: offer.nombreServicio || '' }, estado: 'Pendiente' }
                            await api('/postulaciones', { method: 'POST', body: JSON.stringify(payload) })
                            toast('Postulación enviada')
                            // Reflejar estado postulado
                            apply.disabled = true; apply.classList.remove('btn-warning'); apply.classList.add('btn-secondary'); apply.textContent = 'Postulado';
                        } catch (err) {
                            // Mostrar mensaje específico proveniente del backend
                            toast(err.message || 'No se pudo postular', 'danger')
                        }
                    }
                });

                renderCategories();
                loadOffers();
            </script>
    </body>

</html>