<header class="align-content-center bk-blankest">
  <nav class="navbar  bk-blankest cl-dark navbar-expand-md  navbar-dark " id="myNav">
    <div class="container-fluid p-0 ">
    <a class="navbar-brand " href="/"> <img id="imgHeader" src="/img/logo/logotipoWK.svg"
          alt="logotipo Work Hub"></a>
      <button class="navbar-toggler " type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
        <span class="navbar-toggler-icon cl-dark"></span>
      </button>
      <div class="collapse navbar-collapse justify-content-end  fs" id="collapsibleNavbar">
        <ul class="navbar-nav ">
          <li class="nav-item">
            <a class="nav-link cl-dark my-Link" href="/">Inicio</a>
          </li>
          <li class="nav-item">
            <a class="nav-link cl-dark my-Link" href="#ldg-how-work">Cómo funciona</a>
          </li>
          <li class="nav-item">
            <a class="nav-link cl-dark my-Link" href="/empleado">Buscar Oferta</a>
          </li>
          <li class="nav-item">
            <a class="nav-link cl-dark my-Link" href="/pages/contact-us.html">Contacto</a>
          </li>
        </ul>
        <div class="d-grid gap-2 d-md-flex justify-content-md-end ">
          <% if (!isAuthenticated) { %>
            <button id="login" class="btn-stroke btn me-md-2 " onclick="document.getElementById('modalLogin').showModal()">Iniciar Sesión</button>
            <a href="/registro" id="signUp" class="btn btn-cta">Registrarse</a>
          <% } else { %>
            <div class="d-flex align-items-center gap-2">
              <span class="cl-dark d-none d-md-inline"><%= (user && user.nombres ? user.nombres.split(' ')[0] : '') %></span>
              <div class="dropdown">
              <button class="btn btn-light rounded-circle p-0 d-flex align-items-center justify-content-center overflow-hidden" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width:40px;height:40px;">
                <div id="navbarAvatar" class="user-avatar" data-user="<%= user?._id || user?.sub || '' %>" style="width:100%;height:100%;background-image:url('/img/profile-img/default.png');background-size:cover;background-position:center"></div>
              </button>
              <ul class="dropdown-menu dropdown-menu-end">
                <li class="dropdown-header small text-muted px-3"><%= (user && (user.nombres || user.apellidos) ? ((user.nombres||'') + (user.apellidos? ' ' + user.apellidos : '')) : 'Usuario') %></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/perfil">Perfil</a></li>
                <li><a class="dropdown-item" href="#">Configuraciones</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="/empleado">Ofertas</a></li>
                <li><a class="dropdown-item" href="/empleador">Panel de empleador</a></li>
                <% if (role === 'admin') { %>
                  <li><a class="dropdown-item" href="/admin">Panel Admin</a></li>
                <% } %>
                <li><hr class="dropdown-divider"></li>
                <li>
                  <form method="post" action="/logout" class="px-3">
                    <button class="btn btn-outline-danger w-100" type="submit">Cerrar sesión</button>
                  </form>
                </li>
              </ul>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </nav>
</header>
<script>
  (function(){
    try{
  const dataEl = document.getElementById('PROFILE_USER') || document.getElementById('CURRENT_USER_DATA');
  const me = dataEl ? JSON.parse(dataEl.textContent||'null') : (window.CURRENT_USER || null);
  const nav = document.getElementById('navbarAvatar');
  const meId = (me && (me._id || me.sub)) || (nav?.dataset?.user || null);
  const key = meId ? `avatar:${meId}` : null;
      function hydrateCurrentUserAvatar(){
        try{
          if (!key) return;
          const url = localStorage.getItem(key);
          const finalUrl = url && url.startsWith('data:') ? url : '/img/profile-img/default.png'
          if (nav) nav.style.backgroundImage = `url('${finalUrl}')`;
          document.querySelectorAll('.user-avatar[data-user]')
            .forEach(el => {
              if (String(el.dataset.user||'') === String(meId||'')) {
                el.style.backgroundImage = `url('${finalUrl}')`;
              }
            })
        }catch{}
      }
      window.hydrateCurrentUserAvatar = hydrateCurrentUserAvatar;
      hydrateCurrentUserAvatar();
      document.addEventListener('avatar-updated', (e)=>{
        if (nav && e.detail?.url) nav.style.backgroundImage = `url('${e.detail.url}')`;
        hydrateCurrentUserAvatar();
      })
    }catch{}
  })()
</script>